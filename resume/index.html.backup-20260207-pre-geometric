    // Supabase logging functions
    async function logChatSession(eventType, question = null, response = null) {
      // Skip if Supabase not configured
      if (SUPABASE_URL === 'https://your-project.supabase.co') {
        console.log('Supabase not configured. Would log:', { eventType, chatUser, question, response });
        return;
      }

      try {
        const payload = {
          session_id: chatUser.sessionId,
          user_name: chatUser.name,
          user_email: chatUser.email,
          user_role: chatUser.role,
          event_type: eventType,
          question: question,
          response: response,
          timestamp: new Date().toISOString()
        };

        const res = await fetch(`${SUPABASE_URL}/rest/v1/chat_logs`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'apikey': SUPABASE_ANON_KEY,
            'Authorization': `Bearer ${SUPABASE_ANON_KEY}`
          },
          body: JSON.stringify(payload)
        });

        if (!res.ok) {
          console.error('Failed to log chat:', res.statusText);
