          };
          report.overallScore += 18;

          // 4. Role Relevance (15 points)
          const relevanceResult = this.scoreRelevance(state, targetRole);
          report.categories.relevance = relevanceResult;
          report.overallScore += relevanceResult.score;

          // Calculate grade
          const pct = Math.round((report.overallScore / report.maxScore) * 100);
          if (pct >= 90) report.grade = 'A';
          else if (pct >= 80) report.grade = 'B+';
          else if (pct >= 70) report.grade = 'B';
          else if (pct >= 60) report.grade = 'C';
          else report.grade = 'D';

          // Generate strengths and improvements
          this.generateFeedback(report, state, targetRole);

          return report;
        },

        scoreContent(state) {
          const result = {
            score: 0,
            maxScore: 35,
            checks: []
          };

          // Check action verbs (7 points)
          const achievementAnalysis = ResumeAutomation.AchievementAnalyzer.analyzeExperience(state.experience);
          const actionVerbPct = achievementAnalysis.totalBullets > 0 ?
            (achievementAnalysis.bulletsWithActionVerbs / achievementAnalysis.totalBullets) : 0;
          const actionVerbPoints = Math.round(actionVerbPct * 7);
          result.checks.push({
            name: `Action verbs used (${Math.round(actionVerbPct * 100)}%)`,
            passed: actionVerbPct >= 0.8,
            points: actionVerbPoints
          });
          result.score += actionVerbPoints;

          // Check quantifiable achievements (10 points)
          const metricsPct = achievementAnalysis.totalBullets > 0 ?
            (achievementAnalysis.bulletsWithMetrics / achievementAnalysis.totalBullets) : 0;
          const metricsPoints = Math.round(metricsPct * 10);
          result.checks.push({
            name: `Quantifiable achievements (${achievementAnalysis.bulletsWithMetrics} found)`,
            passed: metricsPct >= 0.5,
            points: metricsPoints
          });
          result.score += metricsPoints;

          // Recent experience (5 points)
          const hasRecent = state.experience.some(exp => exp.isCurrent);
          result.checks.push({
            name: 'Recent experience highlighted',
            passed: hasRecent,
            points: hasRecent ? 5 : 0
          });
          if (hasRecent) result.score += 5;

          // Career progression (5 points)
          const showsProgression = state.experience.length >= 3;
          result.checks.push({
            name: 'Shows career progression',
            passed: showsProgression,
            points: showsProgression ? 5 : 0
          });
          if (showsProgression) result.score += 5;

          // Sufficient skills (5 points)
          const sufficientSkills = state.skills.length >= 5;
          result.checks.push({
            name: 'Sufficient skills listed',
            passed: sufficientSkills,
            points: sufficientSkills ? 5 : 3
          });
          result.score += sufficientSkills ? 5 : 3;

          return result;
        },

        scoreRelevance(state, targetRole) {
          const result = {
            score: 0,
            maxScore: 15,
            checks: [],
            missingKeywords: []
          };

          // Get all resume text
          const resumeText = this.getResumeText(state).toLowerCase();

          // Check role-specific keywords if target role provided
          if (targetRole) {
            const roleKey = targetRole.toLowerCase();
            const roleKeywords = ResumeAutomation.KeywordPatterns.roleKeywords[roleKey] || [];

            if (roleKeywords.length > 0) {
              let foundCount = 0;
              for (const keyword of roleKeywords) {
                if (resumeText.includes(keyword.toLowerCase())) {
                  foundCount++;
                } else {
                  result.missingKeywords.push(keyword);
                }
              }

              const matchPct = foundCount / roleKeywords.length;
              const rolePoints = Math.round(matchPct * 8);
              result.checks.push({
                name: `Role-specific keywords (${Math.round(matchPct * 100)}% match)`,
                passed: matchPct >= 0.5,
                points: rolePoints
              });
              result.score += rolePoints;
            }
          } else {
            // Default score if no target role
            result.score += 5;
            result.checks.push({
              name: 'Role-specific keywords',
              passed: true,
              points: 5,
              note: 'Specify a target role for detailed analysis'
            });
          }

          // Check industry terminology (4 points)
          const industryKeywords = ResumeAutomation.KeywordPatterns.pillars.industryTerminology.keywords;
          const industryFound = industryKeywords.filter(kw => resumeText.includes(kw)).length;
          const industryPct = industryFound / industryKeywords.length;
          result.checks.push({
            name: `Industry terminology (${industryFound} found)`,
            passed: industryPct >= 0.3,
            points: Math.round(industryPct * 4)
          });
          result.score += Math.round(industryPct * 4);

          // Check emerging tech (3 points)
          const emergingKeywords = ResumeAutomation.KeywordPatterns.pillars.emergingTech.keywords;
          const emergingFound = emergingKeywords.filter(kw => resumeText.includes(kw)).length;
          const emergingPoints = emergingFound > 0 ? 3 : 0;
          result.checks.push({
            name: `Emerging tech mentioned (${emergingFound} found)`,
            passed: emergingFound > 0,
            points: emergingPoints
          });
          result.score += emergingPoints;

          return result;
        },

        getResumeText(state) {
          let text = '';
          text += state.meta.name + ' ' + state.meta.title + ' ';

          for (const exp of state.experience) {
            text += exp.company + ' ' + exp.role + ' ' + (exp.context || '') + ' ';
            text += (exp.bullets || []).join(' ') + ' ';
          }

          for (const skill of state.skills) {
            text += skill.name + ' ' + skill.level + ' ';
          }

          return text;
        },

        generateFeedback(report, state, targetRole) {
          // Strengths
          if (report.categories.ats.score >= 25) {
            report.strengths.push('Strong ATS compatibility');
          }
          if (report.categories.content.score >= 28) {
            report.strengths.push('Excellent content quality with quantifiable achievements');
          }
          if (state.experience.some(e => e.isCurrent)) {
            report.strengths.push('Current role clearly highlighted');
          }
          if (state.experience.length >= 4) {
            report.strengths.push('Clear career progression demonstrated');
          }

          // Improvements
          const contentChecks = report.categories.content.checks;
          for (const check of contentChecks) {
            if (!check.passed && check.points < check.maxPoints * 0.7) {
              report.improvements.push(check.name.replace(/\(\d+.*\)/, '') + ' needs attention');
            }
          }

          if (report.categories.relevance.missingKeywords.length > 0) {
            report.missingKeywords = report.categories.relevance.missingKeywords.slice(0, 5);
