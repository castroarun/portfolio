    function getRandomDelay() {
      // Random delay between 800ms and 2200ms to simulate backend processing
      // Shorter responses feel faster, longer ones take more time
      const baseDelay = 600;
      const variableDelay = Math.random() * 1400; // 0-1400ms
      const extraJitter = Math.random() * 200; // Small jitter for realism
      return Math.floor(baseDelay + variableDelay + extraJitter);
    }

    function sendMessage() {
      const input = document.getElementById('chat-input');
      const question = input.value.trim();

      if (!question) return;

      addMessage(question, true);
      input.value = '';

      // Show loading indicator
      showLoadingIndicator();

      // Simulate backend processing with variable delay
      const delay = getRandomDelay();
      setTimeout(() => {
        hideLoadingIndicator();
        const response = getResponse(question);
        addMessage(response);

        // Log Q&A to Supabase
        logChatSession('message', question, response);
      }, delay);
    }

