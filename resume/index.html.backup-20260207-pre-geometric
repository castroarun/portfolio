      if (!emailValidation.valid) {
        emailError.textContent = emailValidation.error;
        emailInput.classList.add('error');
        hasErrors = true;
      }

      // Validate role
      if (!selectedRole) {
        roleError.textContent = 'Please select your role';
        hasErrors = true;
