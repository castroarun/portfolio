          const toggle = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
          toggle.setAttribute('class', 'section-toggle');
          toggle.setAttribute('viewBox', '0 0 24 24');
          toggle.setAttribute('fill', 'none');
          toggle.setAttribute('stroke', 'currentColor');
          toggle.setAttribute('stroke-width', '2');
          toggle.innerHTML = '<polyline points="6 9 12 15 18 9"/>';
          header.appendChild(toggle);
        }

        header.addEventListener('click', () => {
          const section = header.closest('.section');
          if (section) {
            section.classList.toggle('collapsed');
            // Toggle all sibling elements after header
            let sibling = header.nextElementSibling;
            while (sibling) {
              if (section.classList.contains('collapsed')) {
                sibling.style.display = 'none';
              } else {
                sibling.style.display = '';
              }
              sibling = sibling.nextElementSibling;
            }
          }
        });
      });
    }

