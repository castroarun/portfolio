      emailInput.classList.remove('error');

      let hasErrors = false;

      // Validate name
      const nameValidation = validateName(nameInput.value);
      if (!nameValidation.valid) {
        nameError.textContent = nameValidation.error;
        nameInput.classList.add('error');
        hasErrors = true;
