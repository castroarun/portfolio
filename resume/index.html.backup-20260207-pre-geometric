        },

        sections: {
          EXPERIENCE: ['experience', 'work', 'job', 'role', 'career', 'employment'],
          SKILLS: ['skill', 'skills', 'expertise', 'competency', 'ability'],
          PROJECTS: ['project', 'projects', 'portfolio', 'build'],
          CERTIFICATIONS: ['certification', 'certifications', 'credential', 'credentials'],
          ABOUT: ['about', 'summary', 'intro', 'backstory'],
          NAME: ['name', 'title', 'headline'],
          ALL: ['all', 'everything', 'entire']
        },

        parse(message) {
          const msg = message.toLowerCase();
          const result = {
            intent: null,
            section: null,
            target: null,
            value: null,
            targetRole: null,
            canExecute: true,
            reason: null
          };

          // Detect intent
          for (const [intent, keywords] of Object.entries(this.intents)) {
            if (keywords.some(kw => msg.includes(kw))) {
              result.intent = intent;
              break;
            }
          }

          // Detect section
          for (const [section, keywords] of Object.entries(this.sections)) {
            if (keywords.some(kw => msg.includes(kw))) {
              result.section = section;
              break;
            }
          }

          // Extract target role for review (e.g., "for a Principal Architect role")
          const roleMatch = msg.match(/for\s+(?:a\s+)?(.+?)\s+(?:role|position|job)/i);
          if (roleMatch) {
            result.targetRole = roleMatch[1].trim();
          }

          // Extract value (e.g., "Python to 95%")
          const percentMatch = msg.match(/(\d+)%/);
          if (percentMatch) {
            result.value = parseInt(percentMatch[1]);
          }

          // Extract skill name
          const skillMatch = msg.match(/(?:add|update|change|remove|delete)\s+(?:the\s+)?(.+?)\s+(?:skill|to|at|from)/i);
          if (skillMatch) {
            result.target = skillMatch[1].trim();
          }

          return result;
        },

        isResumeCommand(message) {
          const msg = message.toLowerCase();
          const allKeywords = [
            ...Object.values(this.intents).flat(),
            'resume', 'cv', 'skill', 'experience', 'project'
          ];

          // Check if it's a resume-related command
          const isResumeRelated = allKeywords.some(kw => msg.includes(kw));
          const hasActionIntent = Object.values(this.intents).some(keywords =>
            keywords.some(kw => msg.includes(kw))
          );

          return isResumeRelated && hasActionIntent;
        }
