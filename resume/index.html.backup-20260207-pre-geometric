    // ============ Fetch GitHub Contributions (using contributions API) ============
    async function fetchGitHubContributions() {
      try {
        // Fetch both 2025 and 2026 data
        const [res2025, res2026] = await Promise.all([
          fetch(`https://github-contributions-api.jogruber.de/v4/${GITHUB_USERNAME}?y=2025`),
          fetch(`https://github-contributions-api.jogruber.de/v4/${GITHUB_USERNAME}?y=2026`)
        ]);

        const data2025 = res2025.ok ? await res2025.json() : null;
        const data2026 = res2026.ok ? await res2026.json() : null;

        // Merge contributions
        const allContributions = [];
        if (data2025?.contributions) allContributions.push(...data2025.contributions);
        if (data2026?.contributions) allContributions.push(...data2026.contributions);

        return { contributions: allContributions, total: (data2025?.total?.lastYear || 0) + (data2026?.total?.lastYear || 0) };
      } catch (error) {
        console.warn('GitHub contributions fetch failed:', error);
        return null;
      }
    }

    // ============ Generate Contribution Heatmap with Live Data ============
    async function generateHeatmapWithLiveData() {
      const container = document.getElementById('contribution-heatmap');
      if (!container) return;

      container.innerHTML = '<div style="color: var(--text-muted); font-size: 0.8rem;">Loading contributions...</div>';

      let contributionsData = null;
      try {
        contributionsData = await fetchGitHubContributions();
      } catch (e) {
        console.warn('Failed to fetch contributions:', e);
      }

      container.innerHTML = ''; // Clear loading

      const weeks = 16; // Compact view: 16 weeks instead of 52
      const daysPerWeek = 7;
      const today = new Date();
      let totalContributions = 0;
      let recentContributions = 0;

      // Create contribution map from API data
      const contributionMap = {};
      if (contributionsData && contributionsData.contributions && Array.isArray(contributionsData.contributions)) {
        contributionsData.contributions.forEach(day => {
          if (day && day.date) {
            contributionMap[day.date] = day.count || 0;
            totalContributions += day.count || 0;
          }
        });
      }

      // Calculate recent contributions (last 16 weeks)
      for (let i = 0; i < weeks * 7; i++) {
        const d = new Date(today);
        d.setDate(today.getDate() - i);
        const dateKey = d.toISOString().split('T')[0];
        recentContributions += contributionMap[dateKey] || 0;
      }

      // Update total display (show recent count)
      const totalEl = document.getElementById('heatmap-total');
      if (totalEl) {
        totalEl.textContent = recentContributions > 0 ? `(${recentContributions})` : '';
      }

      // Update commits count with actual data
      if (totalContributions > 0) {
        updateStatValue('commits-count', totalContributions);
      }

      for (let w = 0; w < weeks; w++) {
        const weekDiv = document.createElement('div');
        weekDiv.className = 'heatmap-week';

        for (let d = 0; d < daysPerWeek; d++) {
          const dayDiv = document.createElement('div');
          dayDiv.className = 'heatmap-day';

          // Calculate date for this cell
          const daysAgo = (weeks - w - 1) * 7 + (6 - d);
          const cellDate = new Date(today);
          cellDate.setDate(today.getDate() - daysAgo);
          const dateKey = cellDate.toISOString().split('T')[0];

          // Set contribution level based on real data
          const contributions = contributionMap[dateKey] || 0;
          if (contributions > 0) {
            // Use GitHub's level calculation (0, 1-3, 4-6, 7-9, 10+)
            let level;
            if (contributions >= 10) level = 4;
            else if (contributions >= 7) level = 3;
            else if (contributions >= 4) level = 2;
            else level = 1;
            dayDiv.classList.add(`level-${level}`);
          }

          dayDiv.title = `${dateKey}: ${contributions} contribution${contributions !== 1 ? 's' : ''}`;
          weekDiv.appendChild(dayDiv);
        }

        container.appendChild(weekDiv);
      }

      // Scroll to the right to show most recent activity
      const heatmapContainer = container.closest('.heatmap-container');
      if (heatmapContainer) {
        setTimeout(() => {
          heatmapContainer.scrollLeft = heatmapContainer.scrollWidth;
        }, 100);
      }
    }

