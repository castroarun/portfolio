    // ============ Project Status Filter (with Fluid Rearrangement) ============
    function filterProjects(status) {
      // Update legend active state
      document.querySelectorAll('.legend-item').forEach(item => {
        item.classList.remove('active');
        if (item.dataset.filter === status) {
          item.classList.add('active');
        }
      });

      // Filter simple cards with animation
      document.querySelectorAll('.simple-card').forEach(card => {
        if (status === 'all' || card.dataset.status === status) {
          card.classList.remove('filtered-out');
        } else {
          card.classList.add('filtered-out');
        }
      });

      // Filter track nodes with fluid animation
      const trackRows = document.querySelectorAll('.track-row');
      trackRows.forEach(row => {
        const nodes = row.querySelectorAll('.track-node');
        let visibleCount = 0;

        nodes.forEach(node => {
          const nodeStatus = node.dataset.status;
          if (status === 'all' || nodeStatus === status) {
            node.classList.remove('filtered-out');
            visibleCount++;
          } else {
            node.classList.add('filtered-out');
          }
        });

        // Hide entire row if no visible nodes (with animation)
        if (visibleCount === 0) {
          row.classList.add('hidden-row');
        } else {
          row.classList.remove('hidden-row');
        }
      });

      // Filter flip cards
      document.querySelectorAll('.projects-grid .flip-card-container').forEach(card => {
        if (status === 'all' || card.dataset.status === status) {
          card.classList.remove('filtered-out');
          card.style.display = '';
        } else {
          card.classList.add('filtered-out');
          // Delay hiding to allow animation
          setTimeout(() => {
            if (card.classList.contains('filtered-out')) {
              card.style.display = 'none';
            }
          }, 400);
        }
      });

    }

    // Initialize main legend (disable items with 0 count)
    function initializeLegendCounts() {
      const statusCounts = { all: 0, live: 0, building: 0, planning: 0, ideating: 0 };

      // Count all project statuses from track nodes
      document.querySelectorAll('.track-node').forEach(node => {
        const status = node.dataset.status;
        if (status && statusCounts.hasOwnProperty(status)) {
          statusCounts[status]++;
          statusCounts.all++;
        }
      });

      // Update legend items
      document.querySelectorAll('.legend-item').forEach(item => {
        const filter = item.dataset.filter;
        const count = statusCounts[filter] || 0;
        const countSpan = item.querySelector('.legend-count');

        if (countSpan) {
          countSpan.textContent = `(${count})`;
        }

        // Disable items with 0 count (except 'all')
        if (count === 0 && filter !== 'all') {
          item.classList.add('disabled');
        } else {
          item.classList.remove('disabled');
        }
      });
    }

