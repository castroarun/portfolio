        },

        apply(themeName) {
          const theme = this.themes[themeName];
          if (!theme) return false;

          for (const [prop, value] of Object.entries(theme)) {
            document.documentElement.style.setProperty(prop, value);
          }

          ResumeAutomation.state.settings.theme = themeName;
          return true;
        },

        toggle() {
          const current = ResumeAutomation.state.settings.theme;
          const newTheme = current === 'dark' ? 'light' : 'dark';
          return this.apply(newTheme);
        }
      },

      // ===== LAYOUT ENGINE =====
      LayoutEngine: {
        applyCompact() {
          document.body.classList.add('compact-mode');
          ResumeAutomation.state.settings.layout = 'compact';
        },

        applyFull() {
          document.body.classList.remove('compact-mode');
          ResumeAutomation.state.settings.layout = 'full';
        },

        hideSection(sectionId) {
          const section = document.getElementById(sectionId);
          if (section) {
            section.style.display = 'none';
            return true;
          }
          return false;
        },

        showSection(sectionId) {
          const section = document.getElementById(sectionId);
          if (section) {
            section.style.display = '';
            return true;
          }
          return false;
        }
      },

      // ===== CONTENT MANAGER (ENHANCED) =====
      ContentManager: {
        // ---- SKILL OPERATIONS ----
        findSkillElement(skillName) {
          const skillItems = document.querySelectorAll('.skill-item');
          for (const item of skillItems) {
            const nameEl = item.querySelector('.skill-name');
            if (nameEl && nameEl.textContent.toLowerCase().includes(skillName.toLowerCase())) {
              return { item, nameEl };
            }
          }
          return null;
        },

        updateSkill(skillName, newProgress) {
          const skill = ResumeAutomation.state.skills.find(
            s => s.name.toLowerCase().includes(skillName.toLowerCase())
          );
          if (skill) {
            skill.progress = Math.min(100, Math.max(0, newProgress));
            const found = this.findSkillElement(skillName);
            if (found) {
              const progressBar = found.item.querySelector('.skill-progress');
              if (progressBar) {
                progressBar.style.width = `${skill.progress}%`;
                progressBar.style.transition = 'width 0.5s ease';
                found.item.style.animation = 'pulse 0.5s ease';
              }
            }
            return true;
          }
          return false;
        },

        renameSkill(oldName, newName) {
          const skill = ResumeAutomation.state.skills.find(
            s => s.name.toLowerCase().includes(oldName.toLowerCase())
          );
          if (skill) {
            skill.name = newName;
            const found = this.findSkillElement(oldName);
            if (found) {
              found.nameEl.textContent = newName;
              found.item.style.animation = 'pulse 0.5s ease';
            }
            return true;
          }
          return false;
        },

        updateSkillLevel(skillName, newLevel) {
          const skill = ResumeAutomation.state.skills.find(
            s => s.name.toLowerCase().includes(skillName.toLowerCase())
          );
          if (skill) {
            skill.level = newLevel;
            const found = this.findSkillElement(skillName);
            if (found) {
              const levelEl = found.item.querySelector('.skill-level');
              if (levelEl) {
                levelEl.textContent = newLevel;
                found.item.style.animation = 'pulse 0.5s ease';
              }
            }
            return true;
          }
          return false;
        },

        removeSkill(skillName) {
          const index = ResumeAutomation.state.skills.findIndex(
            s => s.name.toLowerCase().includes(skillName.toLowerCase())
          );
          if (index !== -1) {
            const removedSkill = ResumeAutomation.state.skills.splice(index, 1)[0];
            const found = this.findSkillElement(skillName);
            if (found) {
              found.item.style.animation = 'fadeOut 0.3s ease';
              setTimeout(() => found.item.remove(), 300);
            }
            return removedSkill.name;
          }
          return null;
        },

        addSkill(name, category = 'development', level = 'Proficient', progress = 75) {
          const newSkill = { name, category, level, progress };
          ResumeAutomation.state.skills.push(newSkill);
          const skillsList = document.querySelector('.skills-list');
          if (skillsList) {
            const skillHTML = `
              <div class="skill-item" data-category="${category}" style="animation: fadeIn 0.3s ease">
                <div class="skill-header">
                  <span class="skill-name">${name}</span>
                  <span class="skill-level">${level}</span>
                </div>
                <div class="skill-bar">
                  <div class="skill-progress" style="width: ${progress}%"></div>
                </div>
              </div>
            `;
            skillsList.insertAdjacentHTML('beforeend', skillHTML);
          }
          return true;
        },

        listSkills() {
          return ResumeAutomation.state.skills.map(s => s.name);
        },

        // ---- META OPERATIONS ----
        updateName(newName) {
          ResumeAutomation.state.meta.name = newName;
          const nameEl = document.querySelector('.profile-name');
          if (nameEl) {
            nameEl.textContent = newName;
            nameEl.style.animation = 'pulse 0.5s ease';
          }
          return true;
        },

        updateTitle(newTitle) {
          ResumeAutomation.state.meta.title = newTitle;
          const titleEl = document.querySelector('.profile-title');
          if (titleEl) {
            titleEl.textContent = newTitle;
            titleEl.style.animation = 'pulse 0.5s ease';
          }
          return true;
        },

        updateLocation(newLocation) {
          ResumeAutomation.state.meta.location = newLocation;
          const locationEls = document.querySelectorAll('.contact-item');
          for (const el of locationEls) {
            if (el.textContent.includes('Singapore') || el.querySelector('svg path[d*="M12 2"]')) {
              const textNode = el.childNodes[el.childNodes.length - 1];
              if (textNode.nodeType === Node.TEXT_NODE) {
                textNode.textContent = ' ' + newLocation;
              }
              el.style.animation = 'pulse 0.5s ease';
              break;
            }
          }
          return true;
        },

        // ---- EXPERIENCE OPERATIONS ----
        getExperienceItems() {
          return document.querySelectorAll('.timeline-item');
        },

        findExperienceByRole(roleKeyword) {
          const items = this.getExperienceItems();
          for (const item of items) {
            const title = item.querySelector('.timeline-title');
            if (title && title.textContent.toLowerCase().includes(roleKeyword.toLowerCase())) {
              return item;
            }
          }
          return null;
        },

        updateExperienceBullet(roleKeyword, bulletIndex, newText) {
          const item = this.findExperienceByRole(roleKeyword);
          if (item) {
            const bullets = item.querySelectorAll('.timeline-details li');
            if (bullets[bulletIndex]) {
              bullets[bulletIndex].textContent = newText;
              bullets[bulletIndex].style.animation = 'pulse 0.5s ease';
              return true;
            }
          }
          return false;
        },

        addExperienceBullet(roleKeyword, text) {
          const item = this.findExperienceByRole(roleKeyword);
          if (item) {
            const bulletList = item.querySelector('.timeline-details');
            if (bulletList) {
              const newLi = document.createElement('li');
              newLi.textContent = text;
              newLi.style.animation = 'fadeIn 0.3s ease';
              bulletList.appendChild(newLi);
              return true;
            }
          }
          return false;
        },

        removeExperienceBullet(roleKeyword, bulletIndex) {
          const item = this.findExperienceByRole(roleKeyword);
          if (item) {
            const bullets = item.querySelectorAll('.timeline-details li');
            if (bullets[bulletIndex]) {
              bullets[bulletIndex].style.animation = 'fadeOut 0.3s ease';
              setTimeout(() => bullets[bulletIndex].remove(), 300);
              return true;
            }
          }
          return false;
        },

        listExperienceRoles() {
          const items = this.getExperienceItems();
          const roles = [];
          items.forEach(item => {
            const title = item.querySelector('.timeline-title');
            if (title) roles.push(title.textContent);
          });
          return roles;
        },

        // ---- PROJECT OPERATIONS ----
        findProjectCard(projectName) {
          const projects = document.querySelectorAll('.project-card');
          for (const proj of projects) {
            const title = proj.querySelector('.project-title, h4');
            if (title && title.textContent.toLowerCase().includes(projectName.toLowerCase())) {
              return proj;
            }
          }
          return null;
        },

        updateProjectDescription(projectName, newDescription) {
          const proj = this.findProjectCard(projectName);
          if (proj) {
            const desc = proj.querySelector('.project-description, p');
            if (desc) {
              desc.textContent = newDescription;
              desc.style.animation = 'pulse 0.5s ease';
              return true;
            }
          }
          return false;
        },

        addProjectTag(projectName, tag) {
          const proj = this.findProjectCard(projectName);
          if (proj) {
            const tagsContainer = proj.querySelector('.project-tags');
            if (tagsContainer) {
              const tagSpan = document.createElement('span');
              tagSpan.className = 'project-tag';
              tagSpan.textContent = tag;
              tagSpan.style.animation = 'fadeIn 0.3s ease';
              tagsContainer.appendChild(tagSpan);
              return true;
            }
          }
          return false;
        },

        removeProjectTag(projectName, tagText) {
          const proj = this.findProjectCard(projectName);
          if (proj) {
            const tags = proj.querySelectorAll('.project-tag');
            for (const tag of tags) {
              if (tag.textContent.toLowerCase() === tagText.toLowerCase()) {
                tag.style.animation = 'fadeOut 0.3s ease';
                setTimeout(() => tag.remove(), 300);
                return true;
              }
            }
          }
          return false;
        }
      },

      // ===== DEMO MODE =====
      DemoMode: {
        isActive: true, // Always demo mode for visitors

        reset() {
          if (ResumeAutomation.originalState) {
            ResumeAutomation.state = JSON.parse(JSON.stringify(ResumeAutomation.originalState));
            location.reload(); // Simplest way to reset all DOM changes
          }
        }
      },

      // ===== GENERATE REVIEW REPORT =====
      generateReviewReport(targetRole = null) {
        const report = this.Scorer.scoreResume(this.state, targetRole);

        let output = `
<div class="review-report">
<div class="report-header">
<strong>RESUME ANALYSIS REPORT</strong>
</div>

<div class="report-score">
Overall Score: <strong>${report.overallScore}/${report.maxScore}</strong> (Grade: ${report.grade})
</div>

<div class="report-section">
<strong>ATS COMPATIBILITY:</strong> ${report.categories.ats.score}/${report.categories.ats.maxScore}
${report.categories.ats.checks.map(c => `
  ${c.passed ? '✓' : '⚠'} ${c.name}`).join('')}
</div>

<div class="report-section">
<strong>CONTENT QUALITY:</strong> ${report.categories.content.score}/${report.categories.content.maxScore}
${report.categories.content.checks.map(c => `
  ${c.passed ? '✓' : '⚠'} ${c.name}`).join('')}
</div>

<div class="report-section">
<strong>FORMATTING:</strong> ${report.categories.formatting.score}/${report.categories.formatting.maxScore}
${report.categories.formatting.checks.map(c => `
  ${c.passed ? '✓' : '⚠'} ${c.name}`).join('')}
</div>

<div class="report-section">
<strong>ROLE RELEVANCE:</strong> ${report.categories.relevance.score}/${report.categories.relevance.maxScore}
${report.categories.relevance.checks.map(c => `
  ${c.passed ? '✓' : '⚠'} ${c.name}${c.note ? ' (' + c.note + ')' : ''}`).join('')}
</div>`;

        if (report.missingKeywords.length > 0) {
          output += `
<div class="report-section">
<strong>MISSING KEYWORDS${targetRole ? ' for ' + targetRole : ''}:</strong>
${report.missingKeywords.map(kw => `• ${kw}`).join('\n')}
</div>`;
        }

        if (report.strengths.length > 0) {
          output += `
<div class="report-section strengths">
<strong>STRENGTHS:</strong>
${report.strengths.map(s => `• ${s}`).join('\n')}
</div>`;
        }

        if (report.improvements.length > 0) {
          output += `
<div class="report-section improvements">
<strong>IMPROVEMENTS SUGGESTED:</strong>
${report.improvements.map(i => `• ${i}`).join('\n')}
</div>`;
        }

        output += '</div>';

        return output;
      },

      // ===== PROCESS COMMAND (ENHANCED) =====
      processCommand(message) {
        const cmd = this.CommandParser.parse(message);
        const msg = message.toLowerCase();
        const demoNote = '<br><small style="color: var(--text-muted)">Note: Changes are session-only in demo mode.</small>';

        // Handle different intents
        switch (cmd.intent) {
          case 'REVIEW':
            return this.generateReviewReport(cmd.targetRole);

          case 'THEME':
            if (msg.includes('light')) {
              this.ThemeManager.apply('light');
              return '✓ Switched to <strong>light mode</strong>. The resume now uses a light color scheme.';
            } else if (msg.includes('dark')) {
              this.ThemeManager.apply('dark');
              return '✓ Switched to <strong>dark mode</strong>. The resume now uses the original dark color scheme.';
            } else if (msg.includes('toggle')) {
              this.ThemeManager.toggle();
              return `✓ Theme toggled to <strong>${this.state.settings.theme} mode</strong>.`;
            }
            return 'You can switch between <strong>light mode</strong> and <strong>dark mode</strong>. Try "switch to light mode" or "toggle theme".';

          case 'UPDATE':
            // Handle skill rename: "rename Python to Python 3"
            const renameMatch = msg.match(/rename\s+(\w+(?:\s+\w+)?)\s+to\s+(.+)/i);
            if (renameMatch) {
              const oldName = renameMatch[1].trim();
              const newName = renameMatch[2].trim();
              if (this.ContentManager.renameSkill(oldName, newName)) {
                return `✓ Renamed <strong>${oldName}</strong> to <strong>${newName}</strong>.${demoNote}`;
              }
              return `Could not find skill "${oldName}". Available: ${this.ContentManager.listSkills().join(', ')}`;
            }

            // Handle skill level: "change Python level to Expert"
            const levelMatch = msg.match(/(?:change|update|set)\s+(\w+)\s+level\s+to\s+(\w+)/i);
            if (levelMatch) {
              const skillName = levelMatch[1].trim();
              const newLevel = levelMatch[2].trim();
              if (this.ContentManager.updateSkillLevel(skillName, newLevel)) {
                return `✓ Updated <strong>${skillName}</strong> level to <strong>${newLevel}</strong>.${demoNote}`;
              }
              return `Could not find skill "${skillName}".`;
            }

            // Handle name change: "change my name to..." or "update name to..."
            const nameMatch = msg.match(/(?:change|update|set)\s+(?:my\s+)?name\s+to\s+(.+)/i);
            if (nameMatch) {
              const newName = message.match(/(?:change|update|set)\s+(?:my\s+)?name\s+to\s+(.+)/i)[1].trim();
              this.ContentManager.updateName(newName);
              return `✓ Updated name to <strong>${newName}</strong>.${demoNote}`;
            }

            // Handle title change: "change my title to..."
            const titleMatch = msg.match(/(?:change|update|set)\s+(?:my\s+)?title\s+to\s+(.+)/i);
            if (titleMatch) {
              const newTitle = message.match(/(?:change|update|set)\s+(?:my\s+)?title\s+to\s+(.+)/i)[1].trim();
              this.ContentManager.updateTitle(newTitle);
              return `✓ Updated title to <strong>${newTitle}</strong>.${demoNote}`;
            }

            // Handle location change: "change location to..."
            const locMatch = msg.match(/(?:change|update|set)\s+(?:my\s+)?location\s+to\s+(.+)/i);
            if (locMatch) {
              const newLoc = message.match(/(?:change|update|set)\s+(?:my\s+)?location\s+to\s+(.+)/i)[1].trim();
              this.ContentManager.updateLocation(newLoc);
              return `✓ Updated location to <strong>${newLoc}</strong>.${demoNote}`;
            }

            // Handle experience bullet update with validation: "update bullet 1 in Bank of America to: ..."
            const updateBulletMatch = msg.match(/update\s+bullet\s+(\d+)\s+(?:in|at|for)\s+(\w+(?:\s+\w+)?)(?:\s+to)?:\s*(.+)/i);
            if (updateBulletMatch) {
              const bulletIndex = parseInt(updateBulletMatch[1]) - 1; // Convert to 0-based
              const role = updateBulletMatch[2].trim();
              const newText = message.match(/update\s+bullet\s+\d+\s+(?:in|at|for)\s+\w+(?:\s+\w+)?(?:\s+to)?:\s*(.+)/i)[1].trim();

              // Validate the new bullet text against resume best practices
              const bulletValidation = this.ContentValidator.validateBullet(newText);

              if (this.ContentManager.updateExperienceBullet(role, bulletIndex, newText)) {
                let response = `✓ Updated bullet ${bulletIndex + 1} in <strong>${role}</strong>.${demoNote}`;
                response += `<br><div style="margin-top:0.5rem">${this.ContentValidator.formatFeedback(bulletValidation)}</div>`;

                // If score is low, offer improvement suggestion
                if (bulletValidation.improved && bulletValidation.score < 70) {
                  response += `<br><div style="margin-top:0.5rem;padding:0.5rem;background:var(--accent-dim);border-radius:6px;border-left:3px solid var(--accent)">
                    <strong>Consider this improved version:</strong><br>
                    <code style="font-size:0.8rem">Update bullet ${bulletIndex + 1} in ${role} to: ${bulletValidation.improved.replace(/\[add:.+?\]/g, '[X%]')}</code>
                  </div>`;
                }

                return response;
              }
              return `Could not find role "${role}" or bullet ${bulletIndex + 1}. Use "list roles" to see available roles.`;
            }

            // Handle skill progress update (original functionality)
            if (cmd.section === 'SKILLS' && cmd.target && cmd.value) {
              if (this.ContentManager.updateSkill(cmd.target, cmd.value)) {
                return `✓ Updated <strong>${cmd.target}</strong> skill to <strong>${cmd.value}%</strong>.${demoNote}`;
              }
              return `Could not find skill "${cmd.target}". Available: ${this.ContentManager.listSkills().join(', ')}`;
            }

            return `<strong>Update Commands:</strong>
• Update skill: "Update Python to 90%"
• Rename skill: "Rename Python to Python 3"
• Change level: "Change Java level to Expert"
• Change name: "Change my name to John Doe"
• Change title: "Update my title to Principal Architect"
• Change location: "Set location to New York, USA"`;

          case 'ADD':
            // Handle skill addition with validation
            const addSkillMatch = msg.match(/add\s+(\w+(?:\s+\w+)?)\s+(?:skill\s+)?(?:at\s+)?(\d+)?%?/i);
            if (addSkillMatch || cmd.section === 'SKILLS') {
              let skillName, progress;
              if (addSkillMatch) {
                skillName = addSkillMatch[1].trim();
                progress = addSkillMatch[2] ? parseInt(addSkillMatch[2]) : 75;
              } else {
                skillName = cmd.target || 'NewSkill';
                progress = cmd.value || 75;
              }

              // Validate skill against ATS standards
              const skillValidation = this.ContentValidator.validateSkill(skillName);
              const category = skillValidation.suggestedCategory || 'development';

              this.ContentManager.addSkill(skillName, category, 'Proficient', progress);

              let response = `✓ Added <strong>${skillName}</strong> skill at <strong>${progress}%</strong> (${category}).${demoNote}`;

              if (skillValidation.warnings.length > 0) {
                response += `<br><div style="margin-top:0.5rem;color:var(--warning)">⚠ ${skillValidation.warnings.join(', ')}</div>`;
              }

              return response;
            }

            // Handle add bullet with validation & auto-improvement suggestions
            const addBulletMatch = msg.match(/add\s+(?:bullet|point)\s+to\s+(\w+(?:\s+\w+)?):\s*(.+)/i);
            if (addBulletMatch) {
              const role = addBulletMatch[1].trim();
              const bulletText = message.match(/add\s+(?:bullet|point)\s+to\s+\w+(?:\s+\w+)?:\s*(.+)/i)[1].trim();

              // Validate bullet against resume best practices
              const bulletValidation = this.ContentValidator.validateBullet(bulletText);

              if (this.ContentManager.addExperienceBullet(role, bulletText)) {
                let response = `✓ Added bullet to <strong>${role}</strong>.${demoNote}`;

                // Show quality feedback
                response += `<br><div style="margin-top:0.5rem">${this.ContentValidator.formatFeedback(bulletValidation)}</div>`;

                return response;
              }
              return `Could not find role containing "${role}". Available: ${this.ContentManager.listExperienceRoles().join(', ')}`;
            }

            // Handle add project tag
            const addTagMatch = msg.match(/add\s+tag\s+(\w+)\s+to\s+(\w+)/i);
            if (addTagMatch) {
              const tag = addTagMatch[1].trim();
              const project = addTagMatch[2].trim();
              if (this.ContentManager.addProjectTag(project, tag)) {
                return `✓ Added tag <strong>${tag}</strong> to <strong>${project}</strong>.${demoNote}`;
              }
              return `Could not find project "${project}".`;
            }

            return `<strong>Add Commands:</strong>
• Add skill: "Add TypeScript at 85%"
• Add bullet: "Add bullet to Bank of America: Led migration achieving 40% efficiency gain"
• Add tag: "Add tag React to NoteApp"
<div style="margin-top:0.5rem;color:var(--text-muted)"><em>Tip: Bullets are auto-validated for action verbs, metrics, and impact.</em></div>`;

          case 'DELETE':
            // Handle skill removal: "remove Java" or "delete Python skill"
            const removeSkillMatch = msg.match(/(?:remove|delete)\s+(\w+(?:\s+\w+)?)\s*(?:skill)?/i);
            if (removeSkillMatch && cmd.section === 'SKILLS') {
              const skillName = removeSkillMatch[1].trim();
              const removed = this.ContentManager.removeSkill(skillName);
              if (removed) {
                return `✓ Removed <strong>${removed}</strong> skill.${demoNote}`;
              }
              return `Could not find skill "${skillName}". Available: ${this.ContentManager.listSkills().join(', ')}`;
            }

            // Handle remove project tag: "remove tag React from NoteApp"
            const removeTagMatch = msg.match(/(?:remove|delete)\s+tag\s+(\w+)\s+from\s+(\w+)/i);
            if (removeTagMatch) {
              const tag = removeTagMatch[1].trim();
              const project = removeTagMatch[2].trim();
              if (this.ContentManager.removeProjectTag(project, tag)) {
                return `✓ Removed tag <strong>${tag}</strong> from <strong>${project}</strong>.${demoNote}`;
              }
              return `Could not find tag "${tag}" on project "${project}".`;
            }

            // Fall through to HIDE
          case 'HIDE':
            // Handle section hiding: "hide projects" or "hide skills section"
            const hideMatch = msg.match(/hide\s+(?:the\s+)?(\w+)(?:\s+section)?/i);
            if (hideMatch) {
              const sectionName = hideMatch[1].toLowerCase();
              const sectionMap = {
                'skills': 'skills', 'projects': 'projects', 'experience': 'experience',
                'certifications': 'certifications', 'about': 'about'
              };
              const sectionId = sectionMap[sectionName];
              if (sectionId && this.LayoutEngine.hideSection(sectionId)) {
                return `✓ Hidden <strong>${sectionName}</strong> section.${demoNote}`;
              }
              return `Could not hide "${sectionName}". Available sections: ${Object.keys(sectionMap).join(', ')}`;
            }
            return `<strong>Delete/Hide Commands:</strong>
• Remove skill: "Remove Java skill"
• Remove tag: "Remove tag React from NoteApp"
• Hide section: "Hide projects section"`;

          case 'SHOW':
            // Handle section showing: "show projects" or "show skills section"
            const showMatch = msg.match(/show\s+(?:the\s+)?(\w+)(?:\s+section)?/i);
            if (showMatch) {
              const sectionName = showMatch[1].toLowerCase();
              const sectionMap = {
                'skills': 'skills', 'projects': 'projects', 'experience': 'experience',
                'certifications': 'certifications', 'about': 'about'
              };
              const sectionId = sectionMap[sectionName];
              if (sectionId && this.LayoutEngine.showSection(sectionId)) {
                return `✓ Showing <strong>${sectionName}</strong> section.${demoNote}`;
              }
              return `Could not show "${sectionName}". Available sections: ${Object.keys(sectionMap).join(', ')}`;
            }
            return 'To show a section, try: "Show projects section"';

          case 'LAYOUT':
            if (msg.includes('compact') || msg.includes('single page')) {
              this.LayoutEngine.applyCompact();
              return '✓ Applied <strong>compact layout</strong>. Content is now more condensed.';
            } else if (msg.includes('expand') || msg.includes('full')) {
              this.LayoutEngine.applyFull();
              return '✓ Applied <strong>full layout</strong>. Content is now in original form.';
            }
            return 'Layout options: "make it compact" or "expand layout"';

          case 'RESET':
            this.DemoMode.reset();
            return 'Resetting resume to original state...';

          case 'LIST':
            // Handle list commands: "list skills", "list roles"
            if (msg.includes('skill')) {
              return `<strong>Current Skills:</strong><br>${this.ContentManager.listSkills().map(s => `• ${s}`).join('<br>')}`;
            }
            if (msg.includes('role') || msg.includes('experience')) {
              return `<strong>Experience Roles:</strong><br>${this.ContentManager.listExperienceRoles().map(r => `• ${r}`).join('<br>')}`;
            }
            return `<strong>List Commands:</strong>
• "List skills" - Show all skills
• "List roles" - Show all experience entries`;

          case 'VALIDATE':
            // Validate bullet text: "validate: Led team migration project"
            const validateMatch = msg.match(/(?:validate|improve|rewrite|suggest)[:\s]+(.+)/i);
            if (validateMatch) {
              const textToValidate = message.match(/(?:validate|improve|rewrite|suggest)[:\s]+(.+)/i)[1].trim();
              const validation = this.ContentValidator.validateBullet(textToValidate);

              let response = `<strong>Content Quality Analysis</strong>`;
              response += `<br>${this.ContentValidator.formatFeedback(validation)}`;

              if (validation.improved && validation.score < 70) {
                response += `<br><div style="margin-top:0.5rem;padding:0.75rem;background:var(--accent-dim);border-radius:8px;border-left:3px solid var(--accent)">
                  <strong>To add the improved version:</strong><br>
                  <code style="font-size:0.8rem">Add bullet to [role]: ${validation.improved.replace(/\[add:.+?\]/g, '[YOUR METRIC]')}</code>
                </div>`;
              }

              return response;
            }

            return `<strong>Validate Commands:</strong>
• "Validate: Your bullet text here" - Check quality score
• "Improve: Worked on system migration" - Get improved version
• "Rewrite: responsible for team" - Auto-restructure text

<div style="margin-top:0.5rem"><strong>Scoring criteria (100 pts):</strong>
• Action verb start (30 pts)
• Quantifiable metrics (40 pts)
• Impact statement (20 pts)
• Appropriate length (10 pts)</div>`;

          case 'HELP':
            return `<strong>Resume Editing Commands:</strong>

<u>Skills</u>
• Update Python to 90%
• Rename Java to Java 17
• Change Python level to Expert
• Add TypeScript at 85%
• Remove Java skill
• List skills

<u>Profile</u>
• Change my name to John Doe
• Update my title to Principal Architect
• Set location to New York

<u>Experience</u>
• Add bullet to Bank of America: Led system migration
• Update bullet 1 in Bank of America to: Led migration achieving 50% efficiency
• List roles

<u>Content Quality</u>
• Validate: Your bullet text here
• Improve: responsible for team management

<u>Projects</u>
• Add tag React to NoteApp
• Remove tag Flask from project

<u>Layout</u>
• Make it compact / Expand layout
• Hide projects section / Show skills
• Switch to light mode / Toggle theme
• Reset resume

<u>Review</u>
• Review my resume
• Score my resume for Principal Architect`;

          default:
            // Not a recognized command
            return null;
        }
      }
    };

    // ===== INTEGRATE WITH EXISTING CHAT =====
    const originalGetResponse = getResponse;
    getResponse = function(question) {
      // First, check if it's a resume automation command
      if (ResumeAutomation.CommandParser.isResumeCommand(question)) {
        const response = ResumeAutomation.processCommand(question);
        if (response) {
          return response;
        }
      }

      // Fall back to original response handler
      return originalGetResponse(question);
    };
  </script>

  <!-- Image Lightbox Modal -->
  <div class="image-lightbox" id="image-lightbox" onclick="closeLightbox()">
    <span class="lightbox-close">&times;</span>
    <img id="lightbox-image" src="" alt="Enlarged view">
  </div>

  <script>
    // ============ Image Lightbox Functionality ============
    function openLightbox(imgSrc) {
      const lightbox = document.getElementById('image-lightbox');
      const lightboxImg = document.getElementById('lightbox-image');
      lightboxImg.src = imgSrc;
      lightbox.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      const lightbox = document.getElementById('image-lightbox');
      lightbox.classList.remove('active');
      document.body.style.overflow = '';
    }

    // Close lightbox with Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });

    // Attach click handlers to all project images
    document.addEventListener('DOMContentLoaded', () => {
      const projectImages = document.querySelectorAll('.track-back-screenshot img, .deliverable-screenshot img');
      projectImages.forEach(img => {
        img.addEventListener('click', (e) => {
          e.stopPropagation(); // Prevent card flip
          openLightbox(img.src);
        });
      });
    });

    // ============ Dynamic Projects Loader ============
    // Loads projects from projects.json and renders flip-cards and track-timeline dynamically
    // This ensures future projects added to projects.json automatically appear in Digital Resume

    const ProjectLoader = {
      icons: null,

      async init() {
        try {
          const response = await fetch('../data/projects.json');
          if (!response.ok) throw new Error('Failed to load projects.json');
          const data = await response.json();
          this.icons = data.icons;

          // Filter projects that should show in resume
          const projects = data.projects.filter(p => p.display?.showInResume !== false);

          // Render flip cards
          this.renderFlipCards(projects);

          // Render track timeline
          this.renderTrackTimeline(projects);

          // Re-attach lightbox listeners to new images
          this.attachLightboxListeners();

          // Update filter counts
          if (typeof initializeLegendCounts === 'function') {
            initializeLegendCounts();
          }

          console.log(`[ProjectLoader] Loaded ${projects.length} projects from projects.json`);
        } catch (error) {
          console.warn('[ProjectLoader] Using static content:', error.message);
        }
      },

      getIcon(iconName) {
        return this.icons?.[iconName] || this.icons?.clock || '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>';
      },

      getStatusBadge(project) {
        const statusMap = {
          'built': { class: 'built', text: project.statusText || 'Built' },
          'live': { class: 'built', text: project.statusText || 'Live' },
          'building': { class: 'building', text: project.statusText || 'Building' },
          'planning': { class: 'planning', text: project.statusText || 'Planning' },
          'spotify': { class: 'live', text: 'Spotify', style: 'background: rgba(30, 215, 96, 0.15); color: #22c55e;' }
        };
        return statusMap[project.status] || statusMap['building'];
      },

      generateProgressDots(progress) {
        let dots = '';
        for (let i = 1; i <= progress.total; i++) {
          if (i <= progress.completed) {
            dots += '<span class="stage-dot completed" title="Step ' + i + '"></span>';
          } else if (i === progress.inProgress) {
            dots += '<span class="stage-dot in-progress" title="Step ' + i + '"></span>';
          } else {
            dots += '<span class="stage-dot" title="Step ' + i + '"></span>';
          }
        }
        return dots;
      },

      generateTrackDots(progress) {
        let dots = '';
        for (let i = 1; i <= progress.total; i++) {
          if (i <= progress.completed) {
            dots += '<span class="track-workflow-dot completed"></span>';
          } else if (i === progress.inProgress) {
            dots += '<span class="track-workflow-dot in-progress"></span>';
          } else {
            dots += '<span class="track-workflow-dot"></span>';
          }
        }
        return dots;
      },

      generateFlipCard(project) {
        const badge = this.getStatusBadge(project);
        const progressPercent = (project.progress.completed / project.progress.total * 100).toFixed(1);
        const linkButton = project.links?.spotify
          ? `<a href="${project.links.spotify}" target="_blank" class="card-link-btn" onclick="event.stopPropagation()">
              ${this.getIcon('spotify')} Spotify
            </a>`
          : project.links?.github && project.links.github !== '#'
          ? `<a href="${project.links.github}" target="_blank" class="card-link-btn" onclick="event.stopPropagation()">
              ${this.getIcon('github')} GitHub
            </a>`
          : '';

        return `
        <div class="flip-card" onclick="this.classList.toggle('flipped')" data-project-id="${project.id}">
          <div class="flip-card-inner">
            <div class="flip-card-front">
              <div class="card-header">
                <div class="card-icon" style="color: ${project.iconColor};">
                  ${this.getIcon(project.icon)}
                </div>
                <div class="card-title-wrapper">
                  <h3 class="card-title">${project.name} <span class="card-badge ${badge.class}"${badge.style ? ' style="' + badge.style + '"' : ''}>${badge.text}</span></h3>
                  <p class="card-tagline">${project.tagline}</p>
                </div>
              </div>
              <p class="card-description">${project.descriptionHtml}</p>
              <div class="card-tech">
                ${project.tech.map(t => `<span class="tech-chip">${t}</span>`).join('')}
              </div>
              <div class="flip-hint">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                Click to flip
              </div>
            </div>
            <div class="flip-card-back">
              <div class="deliverable-container">
                <div class="deliverable-screenshot">
                  <img src="../${project.image}" alt="${project.name}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;">
                </div>
                <div class="back-header" style="border-bottom: none; padding-bottom: 0; margin-bottom: 0.5rem;">
                  <h4 class="back-title" style="font-size: 0.9rem;">
                    ${this.getIcon(project.icon).replace('viewBox', 'style="width: 16px; height: 16px;" viewBox')}
                    ${project.name}
                  </h4>
                  <span class="card-badge ${badge.class}" style="font-size: 0.6rem;${badge.style ? ' ' + badge.style : ''}">${badge.text}</span>
                </div>
                <p style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 1rem;">${project.shortDesc}</p>
                <div class="workflow-progress">
                  <div class="workflow-progress-header">
                    <span class="workflow-progress-label">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                      9-Step Workflow
                    </span>
                    <span class="workflow-progress-count">${project.progress.completed}/${project.progress.total} Complete</span>
                  </div>
                  <div class="progress-bar-track">
                    <div class="progress-bar-fill ${badge.class}" style="width: ${progressPercent}%;"></div>
                  </div>
                  <div class="workflow-stages">
                    ${this.generateProgressDots(project.progress)}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>`;
      },

      generateTrackNode(project) {
        const badge = this.getStatusBadge(project);
        const linkButton = project.links?.spotify
          ? `<a href="${project.links.spotify}" target="_blank" class="track-link-front" onclick="event.stopPropagation()">
              ${this.getIcon('spotify')} Spotify
            </a>`
          : project.links?.github && project.links.github !== '#'
          ? `<a href="${project.links.github}" target="_blank" class="track-link-front" onclick="event.stopPropagation()">
              ${this.getIcon('github')} GitHub
            </a>`
          : '';

        return `
          <div class="track-node" data-status="${project.status === 'spotify' ? 'live' : project.status}" data-project-id="${project.id}">
            <div class="track-card" onclick="this.classList.toggle('flipped')">
              <div class="track-card-inner">
                <div class="track-card-front">
                  <div class="track-card-header">
                    <div class="track-icon" style="color: ${project.iconColor};">
                      ${this.getIcon(project.icon)}
                    </div>
                    <div class="track-title">${project.name} <span class="track-badge ${badge.class}"${badge.style ? ' style="' + badge.style + '"' : ''}>${badge.text}</span></div>
                  </div>
                  <p class="track-tagline">${project.tagline}</p>
                  <p class="track-description">${project.descriptionHtml}</p>
                  <div class="track-tech">
                    ${project.tech.map(t => `<span class="track-tech-chip">${t}</span>`).join('')}
                  </div>
                  ${linkButton}
                </div>
                <div class="track-card-back">
                  <div class="track-back-screenshot">
                    <img src="../${project.image}" alt="${project.name}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 6px;">
                  </div>
                  <div class="track-back-title">${project.name}</div>
                  <p class="track-back-desc">${project.shortDesc}</p>
                  <div class="track-workflow">
                    <div class="track-workflow-header">
                      <span>9-Step Workflow</span>
                      <span>${project.progress.completed}/${project.progress.total}</span>
                    </div>
                    <div class="track-workflow-dots">
                      ${this.generateTrackDots(project.progress)}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>`;
      },

      renderFlipCards(projects) {
        const container = document.querySelector('.projects-grid');
        if (!container) return;

        // Clear existing cards
        container.innerHTML = '';

        // Generate and insert new cards
        projects.forEach(project => {
          container.innerHTML += this.generateFlipCard(project);
        });
      },

      renderTrackTimeline(projects) {
        const container = document.getElementById('track-timeline');
        if (!container) return;

        // Group projects by track row
        const rows = { 1: [], 2: [], 3: [] };
        projects.forEach(project => {
          const row = project.display?.trackRow || 3;
          if (rows[row]) rows[row].push(project);
        });

        // Generate row HTML
        let timelineHtml = '';

        // Row 1: Featured Projects
        if (rows[1].length > 0) {
          timelineHtml += '<div class="track-row">';
          rows[1].forEach(p => timelineHtml += this.generateTrackNode(p));
          timelineHtml += '</div>';
        }

        // Row 2: Personal & Music Projects
        if (rows[2].length > 0) {
          timelineHtml += '<div class="track-row">';
          rows[2].forEach(p => timelineHtml += this.generateTrackNode(p));
          timelineHtml += '</div>';
        }

        // Row 3: Other Projects
        if (rows[3].length > 0) {
          timelineHtml += '<div class="track-row">';
          rows[3].forEach(p => timelineHtml += this.generateTrackNode(p));
          timelineHtml += '</div>';
        }

        container.innerHTML = timelineHtml;
      },

      attachLightboxListeners() {
        const projectImages = document.querySelectorAll('.track-back-screenshot img, .deliverable-screenshot img');
        projectImages.forEach(img => {
          img.addEventListener('click', (e) => {
            e.stopPropagation();
            if (typeof openLightbox === 'function') {
              openLightbox(img.src);
            }
          });
        });
      }
    };

    // Initialize project loader when DOM is ready
    document.addEventListener('DOMContentLoaded', () => {
      ProjectLoader.init();
    });
  </script>

