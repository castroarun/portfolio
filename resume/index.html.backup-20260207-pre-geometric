    async function fetchRepoScreenshot(repoName, elementId) {
      try {
        // Fetch README from GitHub API
        const response = await fetch(`https://api.github.com/repos/${GITHUB_USERNAME}/${repoName}/readme`, {
          headers: { 'Accept': 'application/vnd.github.v3.raw' }
        });

        if (!response.ok) {
          console.warn(`Could not fetch README for ${repoName}`);
          return;
        }

        const readme = await response.text();

        // Parse README for image URLs - look for screenshot patterns
        // Common patterns: ![Screenshot](url), ![Demo](url), ![Preview](url), ![alt](url.png/jpg/gif)
        const imagePatterns = [
          /!\[(?:screenshot|demo|preview|app)[^\]]*\]\(([^)]+)\)/gi,
          /!\[[^\]]*\]\(([^)]+\.(?:png|jpg|jpeg|gif|webp)[^)]*)\)/gi
        ];

        let imageUrl = null;

        for (const pattern of imagePatterns) {
          const match = pattern.exec(readme);
          if (match && match[1]) {
            imageUrl = match[1];
            break;
          }
        }

        if (!imageUrl) {
          console.log(`No screenshot found in ${repoName} README`);
          return;
        }

        // Convert relative GitHub URLs to raw content
        if (!imageUrl.startsWith('http')) {
          imageUrl = `https://raw.githubusercontent.com/${GITHUB_USERNAME}/${repoName}/main/${imageUrl}`;
        }

        // Update the screenshot container
        const container = document.getElementById(elementId);
        if (container) {
          container.innerHTML = `<img src="${imageUrl}" alt="${repoName} screenshot" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;" onerror="this.parentElement.innerHTML = '<div class=\\'card-screenshot-placeholder\\'><span>Screenshot unavailable</span></div>'">`;
        }

      } catch (error) {
        console.warn(`Error fetching screenshot for ${repoName}:`, error);
      }
    }

    async function loadProjectScreenshots() {
      const promises = Object.entries(PROJECT_REPOS).map(([name, config]) =>
        fetchRepoScreenshot(config.repo, config.elementId)
      );
      await Promise.allSettled(promises);
    }

