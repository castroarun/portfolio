  <button id="go-to-top" class="go-to-top" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" aria-label="Go to top">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M18 15l-6-6-6 6"/>
