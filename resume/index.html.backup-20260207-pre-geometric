      // ===== ACHIEVEMENT ANALYZER =====
      AchievementAnalyzer: {
        patterns: {
          percentage: /(\d+)%/g,
          currency: /\$[\d,]+[KMB]?/gi,
          multiplier: /(\d+)x\b/gi,
          volume: /(\d+)\+?\s*(users|customers|transactions|requests|man-days|members)/gi,
          time: /(\d+)\s*(hours?|days?|weeks?|months?|years?)/gi
        },

        analyzeContent(text) {
          const metrics = {
            percentages: [],
            currencies: [],
            multipliers: [],
            volumes: [],
            times: [],
            hasActionVerb: false,
            score: 0
          };

          // Check for action verbs
          const actionVerbs = /\b(led|designed|architected|implemented|delivered|increased|reduced|optimized|achieved|managed|developed|created|built|established|transformed|drove|mentored|strategized|earned)\b/gi;
          metrics.hasActionVerb = actionVerbs.test(text);

          // Find all metrics
          let match;
          while ((match = this.patterns.percentage.exec(text)) !== null) {
            metrics.percentages.push(match[0]);
          }
          this.patterns.percentage.lastIndex = 0;

          while ((match = this.patterns.multiplier.exec(text)) !== null) {
            metrics.multipliers.push(match[0]);
          }
          this.patterns.multiplier.lastIndex = 0;

          while ((match = this.patterns.volume.exec(text)) !== null) {
            metrics.volumes.push(match[0]);
          }
          this.patterns.volume.lastIndex = 0;

          // Calculate score
          metrics.score = (metrics.hasActionVerb ? 30 : 0) +
            (metrics.percentages.length > 0 ? 25 : 0) +
            (metrics.multipliers.length > 0 ? 25 : 0) +
            (metrics.volumes.length > 0 ? 20 : 0);

          return metrics;
        },

        analyzeExperience(experience) {
          const results = {
            totalBullets: 0,
            bulletsWithMetrics: 0,
            bulletsWithActionVerbs: 0,
            suggestions: []
          };

          for (const exp of experience) {
            for (const bullet of exp.bullets || []) {
              results.totalBullets++;
              const analysis = this.analyzeContent(bullet);
              if (analysis.hasActionVerb) results.bulletsWithActionVerbs++;
              if (analysis.percentages.length > 0 || analysis.multipliers.length > 0 || analysis.volumes.length > 0) {
                results.bulletsWithMetrics++;
              }
            }
          }

          const actionVerbPct = results.totalBullets > 0 ? Math.round((results.bulletsWithActionVerbs / results.totalBullets) * 100) : 0;
          const metricsPct = results.totalBullets > 0 ? Math.round((results.bulletsWithMetrics / results.totalBullets) * 100) : 0;

          if (actionVerbPct < 80) {
            results.suggestions.push(`Start more bullets with action verbs (current: ${actionVerbPct}%)`);
          }
          if (metricsPct < 50) {
            results.suggestions.push(`Add quantifiable metrics to more achievements (current: ${metricsPct}%)`);
          }

          return results;
        }
      },

      // ===== CONTENT VALIDATOR & AUTO-IMPROVER =====
      ContentValidator: {
        actionVerbs: [
          'led', 'designed', 'architected', 'implemented', 'delivered', 'increased',
          'reduced', 'optimized', 'achieved', 'managed', 'developed', 'created',
          'built', 'established', 'transformed', 'drove', 'mentored', 'strategized',
          'spearheaded', 'pioneered', 'orchestrated', 'streamlined', 'accelerated',
          'enhanced', 'automated', 'integrated', 'migrated', 'scaled', 'secured'
        ],

        validateBullet(text) {
          const result = { isValid: true, score: 0, issues: [], suggestions: [], improved: null };
          const words = text.toLowerCase().split(/\s+/);
          const firstWord = words[0].replace(/[^a-z]/g, '');

          // Check 1: Action verb (30 pts)
          const startsWithAction = this.actionVerbs.includes(firstWord);
          if (startsWithAction) { result.score += 30; }
          else {
            result.issues.push('Missing action verb at start');
            result.suggestions.push(`Start with: "${this.suggestActionVerb(text)}..."`);
          }

          // Check 2: Metrics (40 pts)
          const hasMetric = /\d+%|\d+x\b|\$[\d,]+|\b\d+[+]?\s*(users|customers|transactions|man-days|members|projects|systems|teams)/i.test(text);
          if (hasMetric) { result.score += 40; }
          else {
            result.issues.push('No quantifiable metrics');
            result.suggestions.push('Add: %, $, Nx, or counts (e.g., "by 30%", "12 systems")');
          }

          // Check 3: Impact (20 pts)
          const hasImpact = /\b(resulting|leading to|achieving|saving|generating|enabling|improved|reduced|increased|delivered)\b/i.test(text);
          if (hasImpact) { result.score += 20; }
          else {
            result.issues.push('No impact statement');
            result.suggestions.push('Add outcome: "...resulting in X"');
          }

          // Check 4: Length (10 pts)
          if (words.length >= 8 && words.length <= 25) { result.score += 10; }
          else if (words.length < 8) { result.issues.push('Too brief - add detail'); }

          result.isValid = result.score >= 50;
          if (result.score < 70) {
            result.improved = this.autoImprove(text, startsWithAction, hasMetric);
          }
          return result;
        },

        suggestActionVerb(text) {
          const t = text.toLowerCase();
          if (t.includes('team') || t.includes('people')) return 'Led';
          if (t.includes('system') || t.includes('architect')) return 'Architected';
          if (t.includes('automat')) return 'Automated';
          if (t.includes('improve') || t.includes('optimi')) return 'Optimized';
          if (t.includes('build') || t.includes('creat')) return 'Developed';
          if (t.includes('reduc')) return 'Reduced';
          if (t.includes('increas')) return 'Increased';
          if (t.includes('migrat')) return 'Migrated';
          return 'Delivered';
        },

        autoImprove(text, hasVerb, hasMetric) {
          let improved = text.trim();
          if (!hasVerb) {
            const verb = this.suggestActionVerb(text);
            const weak = ['was', 'had', 'did', 'worked', 'helped', 'responsible'];
            const first = improved.split(/\s+/)[0].toLowerCase();
            if (weak.some(w => first.startsWith(w))) {
              improved = verb + ' ' + improved.substring(improved.indexOf(' ') + 1);
            } else {
              improved = verb + ' ' + improved.charAt(0).toLowerCase() + improved.slice(1);
            }
          }
          if (!hasMetric && !improved.includes('[')) {
            improved = improved.replace(/\.$/, '') + ' [add: X% or N count]';
          }
          return improved;
        },

        validateSkill(name) {
          const result = { isValid: true, warnings: [], suggestedCategory: null };
          const atsKw = ResumeAutomation.KeywordPatterns.pillars.hardSkills.keywords;
          if (!atsKw.some(kw => name.toLowerCase().includes(kw))) {
            result.warnings.push('Not a common ATS keyword - verify spelling');
          }
          const n = name.toLowerCase();
          if (n.includes('architect')) result.suggestedCategory = 'architecture';
          else if (n.includes('python') || n.includes('java') || n.includes('react')) result.suggestedCategory = 'development';
          else if (n.includes('sql') || n.includes('data')) result.suggestedCategory = 'data';
          else if (n.includes('aws') || n.includes('azure') || n.includes('kubernetes')) result.suggestedCategory = 'infrastructure';
          return result;
        },

        formatFeedback(v) {
          let h = '';
          if (v.score !== undefined) {
            const e = v.score >= 70 ? '✓' : v.score >= 50 ? '⚠' : '✗';
            h += `<div><strong>${e} Quality: ${v.score}/100</strong></div>`;
          }
          if (v.issues?.length) {
            h += '<div style="color:var(--warning);margin-top:0.3rem">';
            v.issues.forEach(i => { h += `<br>• ${i}`; });
            h += '</div>';
          }
          if (v.suggestions?.length) {
            h += '<div style="color:var(--accent);margin-top:0.3rem">';
            v.suggestions.forEach(s => { h += `<br>💡 ${s}`; });
            h += '</div>';
          }
          if (v.improved) {
            h += `<div style="margin-top:0.5rem;padding:0.5rem;background:var(--bg-hover);border-radius:6px"><strong>Suggested:</strong><br><em>"${v.improved}"</em></div>`;
          }
          return h;
        }
      },

      // ===== RESUME SCORER =====
      Scorer: {
        scoreResume(state, targetRole = null) {
          const report = {
            overallScore: 0,
            maxScore: 100,
            grade: '',
            categories: {},
            strengths: [],
            improvements: [],
            missingKeywords: []
          };

          // 1. ATS Compatibility (30 points)
          const atsResult = ResumeAutomation.ATSRules.checkCompliance(state);
          report.categories.ats = atsResult;
          report.overallScore += atsResult.score;

          // 2. Content Quality (35 points)
          const contentResult = this.scoreContent(state);
          report.categories.content = contentResult;
          report.overallScore += contentResult.score;

          // 3. Formatting (20 points) - assume good since it's a web resume
          report.categories.formatting = {
            score: 18,
            maxScore: 20,
            checks: [
              { name: 'Consistent visual hierarchy', passed: true, points: 5 },
              { name: 'Proper section structure', passed: true, points: 5 },
              { name: 'Balanced white space', passed: true, points: 4 },
              { name: 'Interactive elements work', passed: true, points: 4 }
